<template>
  <div class="container" style="background-color: {{ currentTheme.bg }};">
    <!-- ИГРОВОЕ ПОЛЕ -->
    <div class="board">
      <div for="{{(index, item) in board}}" class="cell-wrapper">
        <input 
          if="{{item !== 0}}" 
          type="button" 
          class="cell {{isAnimationEnabled ? 'anim' : ''}}" 
          style="background-color: {{ currentTileColor }}; color: {{ currentTheme.text }};"
          value="{{item}}" 
          onclick="moveTile(index)"
        />
      </div>
    </div>

    <!-- МЕНЮ НАСТРОЕК -->
    <div class="menu">
      <text class="menu-title" style="color: {{ currentTheme.text }};">Настройки</text>
      <input type="button" class="btn" style="background-color: {{ currentTheme.btnBg }}; color: {{ currentTheme.text }};" value="Тема: {{ isDark ? 'Темная' : 'Светлая' }}" onclick="toggleTheme" />
      <input type="button" class="btn" style="background-color: {{ currentTheme.btnBg }}; color: {{ currentTheme.text }};" value="Цвет: {{ tileStyle === 0 ? 'Стиль 1' : 'Стиль 2' }}" onclick="toggleColor" />
      <input type="button" class="btn" style="background-color: {{ currentTheme.btnBg }}; color: {{ currentTheme.text }};" value="Анимация: {{ isAnimationEnabled ? 'ВКЛ' : 'ВЫКЛ' }}" onclick="toggleAnim" />
      <input type="button" class="btn" style="background-color: {{ currentTheme.btnBg }}; color: {{ currentTheme.text }};" value="Вибро: {{ isVibrateEnabled ? 'ВКЛ' : 'ВЫКЛ' }}" onclick="toggleVib" />
    </div>

    <!-- АВТОР -->
    <div class="credits">
      <text class="credits-label">Создал</text>
      <text class="credits-name">Александр Солдатов</text>
    </div>
  </div>
</template>

<style>
  .container { flex-direction: column; align-items: center; width: 212px; padding-top: 30px; padding-bottom: 30px; }
  .board { width: 180px; flex-wrap: wrap; justify-content: center; margin-bottom: 20px; }
  .cell-wrapper { width: 56px; height: 56px; margin: 2px; justify-content: center; align-items: center; }
  .cell { width: 56px; height: 56px; border-radius: 8px; font-size: 22px; font-weight: bold; }
  .anim { transition: all 0.15s ease-in-out; }
  .menu { flex-direction: column; align-items: center; width: 180px; margin-top: 10px; }
  .menu-title { font-size: 18px; font-weight: bold; margin-bottom: 10px; }
  .btn { width: 170px; height: 35px; border-radius: 6px; font-size: 14px; margin-bottom: 8px; }
  .credits { flex-direction: column; align-items: center; margin-top: 25px; width: 180px; }
  .credits-label { font-size: 12px; color: #8E8E93; }
  .credits-name { font-size: 15px; color: #FFD700; font-weight: bold; margin-top: 2px; }
</style>

<script>
  import storage from '@system.storage'
  import vibrator from '@system.vibrator'

  export default {
    private: {
      board:,
      emptyIndex: 8,
      isDark: true,
      tileStyle: 0,
      isAnimationEnabled: true,
      isVibrateEnabled: true,
      themes: {
        dark: { bg: '#000000', text: '#FFFFFF', btnBg: '#222222' },
        light: { bg: '#FFFFFF', text: '#000000', btnBg: '#E5E5EA' }
      },
      tileColors: [
        { dark: '#1C1C1E', light: '#D1D1D6' },
        { dark: '#007AFF', light: '#34C759' }
      ]
    },
    computed: {
      currentTheme() { return this.isDark ? this.themes.dark : this.themes.light },
      currentTileColor() { return this.tileColors[this.tileStyle][this.isDark ? 'dark' : 'light'] }
    },
    onCreate() {
      this.shuffle();
    },
    shuffle() {
      let arr = [...this.board];
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
      this.board = arr;
      this.emptyIndex = arr.indexOf(0);
    },
    moveTile(index) {
      const r1 = Math.floor(index / 3), c1 = index % 3;
      const r2 = Math.floor(this.emptyIndex / 3), c2 = this.emptyIndex % 3;
      if ((Math.abs(r1 - r2) + Math.abs(c1 - c2)) === 1) {
        let newBoard = [...this.board];
        newBoard[this.emptyIndex] = newBoard[index];
        newBoard[index] = 0;
        this.board = newBoard;
        this.emptyIndex = index;
        this.triggerVibe();
      }
    },
    triggerVibe() {
      if (this.isVibrateEnabled) {
        try { vibrator.vibrate({ mode: 'short' }); } catch(e){}
      }
    },
    toggleTheme() { this.isDark = !this.isDark; this.triggerVibe(); },
    toggleColor() { this.tileStyle = this.tileStyle === 0 ? 1 : 0; this.triggerVibe(); },
    toggleAnim() { this.isAnimationEnabled = !this.isAnimationEnabled; this.triggerVibe(); },
    toggleVib() { this.isVibrateEnabled = !this.isVibrateEnabled; this.triggerVibe(); }
  }
</script>
