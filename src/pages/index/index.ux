<template>
  <div class="container" style="background-color: {{ bgColor }};">
    <div class="board">
      <div for="{{gameMatrix}}" class="cell-wrapper">
        <input 
          if="{{$item !== 0}}" 
          type="button" 
          class="cell {{animClass}}" 
          style="background-color: {{ tileColor }}; color: {{ textColor }};"
          value="{{$item}}" 
          onclick="moveTile($idx)"
        />
      </div>
    </div>
    <div class="menu">
      <text class="menu-title" style="color: {{ textColor }};">Настройки</text>
      <input type="button" class="btn" style="background-color: {{ btnBgColor }}; color: {{ textColor }};" value="Тема: {{ isDark ? 'Темная' : 'Светлая' }}" onclick="toggleTheme" />
      <input type="button" class="btn" style="background-color: {{ btnBgColor }}; color: {{ textColor }};" value="Цвет: {{ tileStyle === 0 ? 'Стиль 1' : 'Стиль 2' }}" onclick="toggleColor" />
      <input type="button" class="btn" style="background-color: {{ btnBgColor }}; color: {{ textColor }};" value="Анимация: {{ isAnim ? 'ВКЛ' : 'ВЫКЛ' }}" onclick="toggleAnim" />
      <input type="button" class="btn" style="background-color: {{ btnBgColor }}; color: {{ textColor }};" value="Вибро: {{ isVib ? 'ВКЛ' : 'ВЫКЛ' }}" onclick="toggleVib" />
    </div>
    <div class="credits">
      <text class="credits-label">Создал</text>
      <text class="credits-name">Александр Солдатов</text>
    </div>
  </div>
</template>

<style>
  .container { flex-direction: column; align-items: center; width: 212px; padding-top: 30px; padding-bottom: 30px; }
  .board { width: 184px; flex-wrap: wrap; justify-content: center; margin-bottom: 20px; }
  .cell-wrapper { width: 43px; height: 43px; margin: 1.5px; justify-content: center; align-items: center; }
  .cell { width: 43px; height: 43px; border-radius: 6px; font-size: 18px; font-weight: bold; }
  .anim { transition: all 0.15s ease-in-out; }
  .menu { flex-direction: column; align-items: center; width: 180px; margin-top: 10px; }
  .menu-title { font-size: 18px; font-weight: bold; margin-bottom: 10px; }
  .btn { width: 170px; height: 35px; border-radius: 6px; font-size: 14px; margin-bottom: 8px; }
  .credits { flex-direction: column; align-items: center; margin-top: 25px; width: 180px; }
  .credits-label { font-size: 12px; color: #8E8E93; }
  .credits-name { font-size: 15px; color: #FFD700; font-weight: bold; margin-top: 2px; }
</style>

<script src="./index.js"></script>
