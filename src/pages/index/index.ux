<template>
  <div class="container" style="background-color: {{ isDark ? '#000000' : '#FFFFFF' }};">
    
    <!-- ЭКРАН 1: ИГРОВОЙ ПРОЦЕСС -->
    <div if="{{ !showSettingsMenu }}" class="game-screen">
      <!-- Игровое поле -->
      <div class="board" style="width: 184px;">
        <div for="{{(index, item) in gameMatrix}}" class="cell-wrapper" style="width: {{ cellSizePx }}px; height: {{ cellSizePx }}px; margin: 1.5px;">
          <input 
            if="{{item !== 0}}" 
            type="button" 
            class="cell" 
            style="background-color: {{ currentTileColor }}; color: {{ isDark ? '#FFFFFF' : '#000000' }}; width: {{ cellSizePx }}px; height: {{ cellSizePx }}px; font-size: {{ fontSizePx }}px;"
            value="{{item}}" 
            onclick="moveTile(index)"
          />
        </div>
      </div>

      <!-- Счётчики перенесены строго ПОД игру -->
      <div class="stats-row">
        <text class="stats-row-text" style="color: {{ isDark ? '#FFFFFF' : '#000000' }};">ВРЕМЯ {{ formattedTime }}</text>
        <text class="stats-row-text" style="color: {{ isDark ? '#FFFFFF' : '#000000' }};">ШАГИ {{ moves }}</text>
      </div>

      <!-- Экран Победы -->
      <div if="{{ isWon }}" class="victory-block">
        <text class="victory-title" style="color: #34C759; font-size: 22px; font-weight: bold;">ПОБЕДА</text>
      </div>

      <!-- Главное игровое управление (Вынесено к плашкам) -->
      <div class="menu">
        <input type="button" class="btn btn-action" value="{{ autoPlaying ? 'Стоп Автоход' : 'Автоход' }}" onclick="toggleAutoRun" />
        <input type="button" class="btn" style="background-color: {{ currentTileColor }}; color: #FFFFFF;" value="Новая игра" onclick="clickResetGame" />
        <input type="button" class="btn btn-back" style="margin-top: 5px;" value="Настройки" onclick="openSettings" />
      </div>
    </div>

    <!-- ЭКРАН 2: ОТДЕЛЬНОЕ МЕНЮ НАСТРОЕК (Системное) -->
    <div if="{{ showSettingsMenu }}" class="settings-screen">
      <text class="menu-title" style="color: {{ isDark ? '#FFFFFF' : '#000000' }};">Настройки</text>
      
      <input type="button" class="btn" style="background-color: {{ isDark ? '#222222' : '#E5E5EA' }}; color: {{ isDark ? '#FFFFFF' : '#000000' }};" value="Режим: {{ gridSize }}x{{ gridSize }}" onclick="cycleGridSize" />
      <input type="button" class="btn" style="background-color: {{ isDark ? '#222222' : '#E5E5EA' }}; color: {{ isDark ? '#FFFFFF' : '#000000' }};" value="Цвет: {{ tileStyleName }}" onclick="toggleColor" />
      <input type="button" class="btn" style="background-color: {{ isDark ? '#222222' : '#E5E5EA' }}; color: {{ isDark ? '#FFFFFF' : '#000000' }};" value="Тема: {{ isDark ? 'Темная' : 'Светлая' }}" onclick="toggleTheme" />
      
      <!-- iOS Переключатели (Тумблеры) -->
      <div class="ios-row" onclick="toggleAnim">
        <text class="ios-label" style="color: {{ isDark ? '#FFFFFF' : '#000000' }};">Анимация</text>
        <div class="ios-switch {{ isAnim ? 'ios-switch-on' : 'ios-switch-off' }}">
          <div class="ios-dot {{ isAnim ? 'ios-dot-on' : 'ios-dot-off' }}"></div>
        </div>
      </div>

      <div class="ios-row" onclick="toggleVib">
        <text class="ios-label" style="color: {{ isDark ? '#FFFFFF' : '#000000' }};">Вибрация</text>
        <div class="ios-switch {{ isVib ? 'ios-switch-on' : 'ios-switch-off' }}">
          <div class="ios-dot {{ isVib ? 'ios-dot-on' : 'ios-dot-off' }}"></div>
        </div>
      </div>

      <!-- Кнопка возврата к игре -->
      <input type="button" class="btn btn-back" style="margin-top: 12px;" value="Вернуться" onclick="closeSettings" />
    </div>

    <div class="credits">
      <text class="credits-label" style="color: #8E8E93;">Разработчик</text>
      <text class="credits-name" style="color: #FFD700;">Александр Солдатов</text>
    </div>
  </div>
</template>

<style>
  .container { flex-direction: column; align-items: center; width: 212px; padding-top: 35px; padding-bottom: 35px; }
  .game-screen { flex-direction: column; align-items: center; width: 212px; }
  .settings-screen { flex-direction: column; align-items: center; width: 212px; }
  
  .stats-row { width: 160px; justify-content: space-between; margin-top: 15px; margin-bottom: 10px; padding: 0 2px; }
  .stats-row-text { font-size: 11px; font-weight: bold; }
  
  .board { flex-wrap: wrap; justify-content: center; }
  .cell-wrapper { justify-content: center; align-items: center; }
  .cell { border-radius: 8px; font-weight: bold; }
  
  .victory-block { flex-direction: column; align-items: center; margin-bottom: 8px; }
  
  .menu { flex-direction: column; align-items: center; width: 180px; margin-top: 5px; }
  .menu-title { font-size: 16px; font-weight: bold; margin-bottom: 15px; text-align: center; }
  
  .btn { width: 170px; height: 35px; border-radius: 8px; font-size: 14px; margin-bottom: 8px; font-weight: bold; }
  .btn-action { background-color: #007AFF; color: #FFFFFF; }
  .btn-back { background-color: #8E8E93; color: #FFFFFF; }

  /* iOS переключатели */
  .ios-row { width: 170px; height: 38px; justify-content: space-between; align-items: center; margin-bottom: 8px; padding: 0 4px; }
  .ios-label { font-size: 14px; }
  .ios-switch { width: 44px; height: 24px; border-radius: 12px; padding: 2px; }
  .ios-switch-on { background-color: #34C759; }
  .ios-switch-off { background-color: #48484A; }
  .ios-dot { width: 20px; height: 20px; border-radius: 10px; background-color: #FFFFFF; }
  .ios-dot-on { margin-left: 20px; }
  .ios-dot-off { margin-left: 0; }
  
  .credits { flex-direction: column; align-items: center; margin-top: 25px; width: 180px; }
  .credits-label { font-size: 10px; }
  .credits-name { font-size: 13px; font-weight: bold; margin-top: 1px; }
</style>

<script>
  import vibrator from '@system.vibrator'
  
  export default {
    private: {
      gameMatrix: [],
      gridSize: 4,
      emptyIndex: 15,
      moves: 0,
      timerSeconds: 0,
      timerId: null,
      isDark: true,
      tileStyle: 0, // ИСПРАВЛЕНО: Теперь жестко стартуем со Стиля 1
      isAnim: true,
      isVib: true,
      isWon: false,
      autoPlaying: false,
      autoTimerId: null,
      showSettingsMenu: false,
      tileColors: [
        { dark: '#1C1C1E', light: '#D1D1D6' }, // Стиль 1
        { dark: '#007AFF', light: '#34C759' }, // Стиль 2
        { dark: '#8A2BE2', light: '#FF007F' }, // Стиль 3
        { dark: '#FF4500', light: '#FFA500' }, // Стиль 4
        { dark: '#00FF66', light: '#00A344' }  // Стиль 5
      ],
      styleNames: ['Стиль 1', 'Стиль 2', 'Стиль 3', 'Стиль 4', 'Стиль 5']
    },
    computed: {
      currentTileColor() { return this.tileColors[this.tileStyle][this.isDark ? 'dark' : 'light']; },
      tileStyleName() { return this.styleNames[this.tileStyle]; },
      formattedTime() {
        const m = Math.floor(this.timerSeconds / 60).toString();
        const s = (this.timerSeconds % 60).toString();
        const padM = m.length < 2 ? '0' + m : m;
        const padS = s.length < 2 ? '0' + s : s;
        return padM + ':' + padS;
      },
      cellSizePx() {
        if (this.gridSize === 3) return 58;
        if (this.gridSize === 5) return 33;
        return 43;
      },
      fontSizePx() {
        if (this.gridSize === 3) return 24;
        if (this.gridSize === 5) return 14;
        return 18;
      }
    },
    onCreate() {
      this.resetGame();
    },
    onDestroy() {
      this.stopTimer();
      this.stopAutoRun();
    },
    openSettings() {
      this.showSettingsMenu = true;
      this.triggerVibe('short');
    },
    closeSettings() {
      this.showSettingsMenu = false;
      this.triggerVibe('short');
    },
    clickResetGame() {
      this.resetGame();
      this.triggerVibe('short');
    },
    resetGame() {
      this.stopTimer();
      this.stopAutoRun();
      this.moves = 0;
      this.timerSeconds = 0;
      this.isWon = false;
      
      let totalCells = this.gridSize * this.gridSize;
      let arr = [];
      for (let i = 1; i < totalCells; i++) arr.push(i);
      arr.push(0);
      
      this.gameMatrix = arr;
      this.emptyIndex = totalCells - 1;
      
      for (let shuffle = 0; shuffle < 30; shuffle++) {
        const possible = [];
        const r = Math.floor(this.emptyIndex / this.gridSize);
        const c = this.emptyIndex % this.gridSize;
        if (r > 0) possible.push(this.emptyIndex - this.gridSize);
        if (r < this.gridSize - 1) possible.push(this.emptyIndex + this.gridSize);
        if (c > 0) possible.push(this.emptyIndex - 1);
        if (c < this.gridSize - 1) possible.push(this.emptyIndex + 1);
        
        const nextIdx = possible[Math.floor(Math.random() * possible.length)];
        this.gameMatrix[this.emptyIndex] = this.gameMatrix[nextIdx];
        this.gameMatrix[nextIdx] = 0;
        this.emptyIndex = nextIdx;
      }
    },
    startTimer() {
      if (!this.timerId) {
        this.timerId = setInterval(() => { this.timerSeconds++; }, 1000);
      }
    },
    stopTimer() {
      if (this.timerId) { clearInterval(this.timerId); this.timerId = null; }
    },
    moveTile(index) {
      if (this.isWon) return;
      const r1 = Math.floor(index / this.gridSize), c1 = index % this.gridSize;
      const r2 = Math.floor(this.emptyIndex / this.gridSize), c2 = this.emptyIndex % this.gridSize;
      
      if ((Math.abs(r1 - r2) + Math.abs(c1 - c2)) === 1) {
        if (this.moves === 0 && !this.autoPlaying) this.startTimer();
        
        this.gameMatrix[this.emptyIndex] = this.gameMatrix[index];
        this.gameMatrix[index] = 0;
        this.emptyIndex = index;
        this.moves++;
        this.triggerVibe('short');
        this.checkWin();
      }
    },
    checkWin() {
      let totalCells = this.gridSize * this.gridSize;
      for (let i = 0; i < totalCells - 1; i++) {
        if (this.gameMatrix[i] !== i + 1) return;
      }
      this.isWon = true;
      this.stopTimer();this.stopAutoRun();
this.triggerVibe('long');
},
toggleAutoRun() {
if (this.autoPlaying) {
this.stopAutoRun();
} else {
this.autoPlaying = true;
this.startTimer();
this.autoTimerId = setInterval(() => {
this.makeSingleHint();
if (this.isWon) this.stopAutoRun();
}, 450);
}
},
stopAutoRun() {
this.autoPlaying = false;
if (this.autoTimerId) { clearInterval(this.autoTimerId); this.autoTimerId = null; }
},
makeSingleHint() {
const possibleMoves = [];
const r2 = Math.floor(this.emptyIndex / this.gridSize);
const c2 = this.emptyIndex % this.gridSize;
if (r2 > 0) possibleMoves.push((r2 - 1) * this.gridSize + c2);
if (r2 < this.gridSize - 1) possibleMoves.push((r2 + 1) * this.gridSize + c2);
if (c2 > 0) possibleMoves.push(r2 * this.gridSize + (c2 - 1));
if (c2 < this.gridSize - 1) possibleMoves.push(r2 * this.gridSize + (c2 + 1));
if (possibleMoves.length > 0) {
const targetIndex = possibleMoves[Math.floor(Math.random() * possibleMoves.length)];
this.moveTile(targetIndex);
}
},
cycleGridSize() {
this.gridSize = this.gridSize === 5 ? 3 : this.gridSize + 1;
this.resetGame();
},
triggerVibe(mode) {
if (this.isVib) { try { vibrator.vibrate({ mode: mode }); } catch(e){} }
},
toggleTheme() { this.isDark = !this.isDark; this.triggerVibe('short'); },
toggleColor() { this.tileStyle = (this.tileStyle + 1) % this.tileColors.length; this.triggerVibe('short'); },
toggleAnim() { this.isAnim = !this.isAnim; this.triggerVibe('short'); },
toggleVib() { this.isVib = !this.isVib; this.triggerVibe('short'); }
}
