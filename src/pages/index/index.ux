<template>
  <div class="container" style="background-color: {{ isDark ? '#000000' : '#FFFFFF' }};">
    <!-- ИГРОВОЕ ПОЛЕ -->
    <div class="board">
      <div for="{{(index, item) in board}}" class="cell-wrapper">
        <input 
          if="{{item !== 0}}" 
          type="button" 
          class="cell {{isAnimationEnabled ? 'anim' : ''}}" 
          style="background-color: {{ currentTileColor }}; color: {{ isDark ? '#FFFFFF' : '#000000' }};"
          value="{{item}}" 
          onclick="moveTile(index)"
        />
      </div>
    </div>

    <!-- МЕНЮ НАСТРОЕК -->
    <div class="menu">
      <text class="menu-title" style="color: {{ isDark ? '#FFFFFF' : '#000000' }};">Настройки</text>
      
      <input type="button" class="btn" style="background-color: {{ isDark ? '#222222' : '#E5E5EA' }}; color: {{ isDark ? '#FFFFFF' : '#000000' }};" value="Тема: {{ isDark ? 'Темная' : 'Светлая' }}" onclick="toggleTheme" />
      <input type="button" class="btn" style="background-color: {{ isDark ? '#222222' : '#E5E5EA' }}; color: {{ isDark ? '#FFFFFF' : '#000000' }};" value="Цвет: {{ tileStyle === 0 ? 'Стиль 1' : 'Стиль 2' }}" onclick="toggleColor" />
      <input type="button" class="btn" style="background-color: {{ isDark ? '#222222' : '#E5E5EA' }}; color: {{ isDark ? '#FFFFFF' : '#000000' }};" value="Анимация: {{ isAnimationEnabled ? 'ВКЛ' : 'ВЫКЛ' }}" onclick="toggleAnim" />
      <input type="button" class="btn" style="background-color: {{ isDark ? '#222222' : '#E5E5EA' }}; color: {{ isDark ? '#FFFFFF' : '#000000' }};" value="Вибро: {{ isVibrateEnabled ? 'ВКЛ' : 'ВЫКЛ' }}" onclick="toggleVib" />
    </div>

    <!-- АВТОР -->
    <div class="credits">
      <text class="credits-label">Создал</text>
      <text class="credits-name">Александр Солдатов</text>
    </div>
  </div>
</template>

<style>
  .container { flex-direction: column; align-items: center; width: 212px; padding-top: 30px; padding-bottom: 30px; }
  .board { width: 180px; flex-wrap: wrap; justify-content: center; margin-bottom: 20px; }
  .cell-wrapper { width: 56px; height: 56px; margin: 2px; justify-content: center; align-items: center; }
  .cell { width: 56px; height: 56px; border-radius: 8px; font-size: 22px; font-weight: bold; border-width: 0px; }
  .anim { transition: all 0.15s ease-in-out; }
  .menu { flex-direction: column; align-items: center; width: 180px; margin-top: 10px; }
  .menu-title { font-size: 18px; font-weight: bold; margin-bottom: 10px; }
  .btn { width: 170px; height: 35px; border-radius: 6px; font-size: 14px; margin-bottom: 8px; border-width: 0px; }
  .credits { flex-direction: column; align-items: center; margin-top: 25px; width: 180px; }
  .credits-label { font-size: 12px; color: #8E8E93; }
  .credits-name { font-size: 15px; color: #FFD700; font-weight: bold; margin-top: 2px; }
</style>

<script>
  // Полностью убрали импорт @system.storage для стабильности запуска
  import vibrator from '@system.vibrator'

  export default {
    private: {
      board:,
      emptyIndex: 8,
      isDark: true,
      tileStyle: 0,
      isAnimationEnabled: true,
      isVibrateEnabled: true,
      tileColors: [
        { dark: '#1C1C1E', light: '#D1D1D6' },
        { dark: '#007AFF', light: '#34C759' }
      ]
    },
    computed: {
      currentTileColor() { 
        return this.tileColors[this.tileStyle][this.isDark ? 'dark' : 'light'] 
      }
    },
    onCreate() {
      // Вызываем перемешивание сразу без ожидания памяти
      this.shuffle();
    },
    shuffle() {
      // Безопасное перемешивание без do-while циклов: делаем 20 случайных ходов из собранного состояния
      // Это на 100% гарантирует математическую решаемость и исключает зависание процессора
      let currentBoard =;
      let emptyIdx = 8;

      for (let i = 0; i < 30; i++) {
        const r = Math.floor(emptyIdx / 3);
        const c = emptyIdx % 3;
        let validMoves = [];

        if (r > 0) validMoves.push(emptyIdx - 3); // движение вверх
        if (r < 2) validMoves.push(emptyIdx + 3); // движение вниз
        if (c > 0) validMoves.push(emptyIdx - 1); // движение влево
        if (c < 2) validMoves.push(emptyIdx + 1); // движение вправо

        // Выбираем случайное направление из возможных
        const randomMove = validMoves[Math.floor(Math.random() * validMoves.length)];
        
        // Меняем местами
        currentBoard[emptyIdx] = currentBoard[randomMove];
        currentBoard[randomMove] = 0;
        emptyIdx = randomMove;
      }

      this.board = currentBoard;
      this.emptyIndex = emptyIdx;
    },
    moveTile(index) {
      const r1 = Math.floor(index / 3), c1 = index % 3;
      const r2 = Math.floor(this.emptyIndex / 3), c2 = this.emptyIndex % 3;
      
      if ((Math.abs(r1 - r2) + Math.abs(c1 - c2)) === 1) {
        let newBoard = [...this.board];
        newBoard[this.emptyIndex] = newBoard[index];
        newBoard[index] = 0;
        this.board = newBoard;
        this.emptyIndex = index;
        this.triggerVibe();
      }
    },
    triggerVibe() {
      if (this.isVibrateEnabled) {
        // Оборачиваем в строгий try-catch, чтобы отказ вибромотора не вешал игру
        try { 
          vibrator.vibrate({ mode: 'short' }); 
        } catch(e) {
          console.log('Вибрация не вызвалась');
        }
      }
    },
    toggleTheme() { this.isDark = !this.isDark; this.triggerVibe(); },
    toggleColor() { this.tileStyle = this.tileStyle === 0 ? 1 : 0; this.triggerVibe(); },
    toggleAnim() { this.isAnimationEnabled = !this.isAnimationEnabled; this.triggerVibe(); },
    toggleVib() { this.isVibrateEnabled = !this.isVibrateEnabled; this.triggerVibe(); }
  }
</script>
